{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wowquestvoice-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wowquestvoice-collector",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "wowquestvoice-audio"
    }
  ]
}
